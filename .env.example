# Copie para .env (desenvolvimento). Em producao vem de Secret/ConfigMap do AKS,
# com os segredos vindos do Key Vault via CSI driver.

# Obrigatorios — o processo nao sobe sem eles, de proposito.
POSTGRES_URL=postgresql://otimizador:senha@localhost:5432/otimizador
SERVICE_BUS_CONN=

# Autenticacao. Vazios = servico SEM auth (modo desenvolvimento); o /readyz avisa.
# Com ENTRA_AUDIENCE preenchida, todo request exige `Authorization: Bearer`.
ENTRA_TENANT_ID=
# O que o token tem de declarar em `aud`: o client id (GUID) ou o Application ID
# URI (`api://...`) da app registration. Sem ela, um token legitimo emitido para
# OUTRA aplicacao do mesmo tenant entraria aqui.
ENTRA_AUDIENCE=

# Os tres abaixo so existem para apontar a validacao para outro provedor OIDC —
# ver `docker-compose.sso.yml`. Contra o Entra, deixe vazios: os dois primeiros
# sao derivados do tenant, e o terceiro so e preciso se o tenant emitir o login
# num claim fora da cadeia conhecida.
ENTRA_JWKS_URL=
ENTRA_ISSUER=
ENTRA_CLAIM_LOGIN=

# Vite em outra porta durante o desenvolvimento.
ORIGENS_CORS=["http://localhost:5173"]
AMBIENTE=desenvolvimento
