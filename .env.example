# Copie para .env (desenvolvimento). Em producao vem de Secret/ConfigMap do AKS,
# com os segredos vindos do Key Vault via CSI driver.

# Obrigatorios — o processo nao sobe sem eles, de proposito.
POSTGRES_URL=postgresql://otimizador:senha@localhost:5432/otimizador
SERVICE_BUS_CONN=

# Autenticacao. Vazios = servico SEM auth (modo desenvolvimento); o /readyz avisa.
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

# Vite em outra porta durante o desenvolvimento.
ORIGENS_CORS=["http://localhost:5173"]
AMBIENTE=desenvolvimento
